# Local scientific payloads. Keep catalog documentation and small source
# fixtures trackable; ignore only payload locations and their caches.
datasets/**/*.h5
datasets/**/*.hdf5
datasets/**/*.pt
datasets/**/*.pth
datasets/**/*.npy
datasets/**/*.npz
datasets/**/cache
datasets/**/generated
datasets/**/manifests

# Local case runs, generated manifests, comparisons, and experiment profiles.
cases/**/runs/
cases/**/runs
cases/**/manifests
cases/**/comparisons/*.json
cases/**/comparisons/*.csv
cases/**/comparisons/*.html
cases/**/comparisons/*.png
cases/**/comparisons/*.md
cases/**/configs/_experiments

# Root-level run/checkpoint directories are local when used by ad-hoc tools.
runs/
checkpoints/
/runs
/checkpoints

# Benchmark reports and derived output. Protocols, configs, scripts, and
# deliberately retained tiny fixtures remain source files.
benchmarks/**/reports
benchmarks/**/generated
benchmarks/**/report/*.json
benchmarks/**/report/*.csv
benchmarks/**/report/*.html
benchmarks/**/report/*.png
benchmarks/**/report/*.svg
benchmarks/**/report/*.pdf
benchmarks/**/execution/*.json
benchmarks/**/comparison/*.json
benchmarks/**/comparison/*.csv
benchmarks/**/comparison/*.html
benchmarks/**/baseline/*.json
benchmarks/**/baseline/*.csv
benchmarks/**/runs_summary

# Raw historical exports and machine-local aliases. Reviewed publications live
# as ordinary files in UpdatePlans/_Reports and are deliberately trackable.
/figures/
/reports/
/artifacts/
/figures
/reports
/artifacts
cases/**/diagnostics/**/.work

# Python, test, editor, and build caches.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/
.venv/
venv/
.env
.DS_Store

# Local benchmark/experiment notes may be kept outside the tracked tree.
local-experiments

# Dated operational reports retained locally; shared method/protocol guides
# live in docs/Posttraining_*.md and docs/Fidelity_Budget_Posttraining.md.
/docs/Fidelity_Budget_Formal_Runs_11_13.md
/docs/Run11_Dense_Implementation_Optimization.md
/docs/Run11_Epoch100_Review_and_Continuation.md
/docs/Run11_Sparse_Fidelity_100ep.md
/docs/Run11_LR_Warmup_20ep.md

# Optional historical source retained only for local compatibility checks.
LegacyCoherence/
/LegacyCoherence

# Publish reviewed plans/reports, not entire historical research collections.
# A slash-only directory rule does not ignore a directory symlink: retain the
# exact-path rules below when a local collection is moved to DATA2.
!/UpdatePlans/
/UpdatePlans/*
!/UpdatePlans/README.md
!/UpdatePlans/_Plans/
!/UpdatePlans/_Reports/
/UpdatePlans/_Plans/_bk/Legacy_Local_Plans
/UpdatePlans/_Reports/_bk/Legacy_Local_Reports
/UpdatePlans/_Plans/*.md
/UpdatePlans/_Plans/*.pdf
/UpdatePlans/_Plans/*.html
/UpdatePlans/_Reports/*.md
!/UpdatePlans/_Reports/README.md
/UpdatePlans/_Reports/Posttraining_Theory_Review_20261105
/UpdatePlans/_Reports/figures
/UpdatePlans/_Reports/reports
/UpdatePlans/_Plans/CoherenceComputeEnhancement_Audit
/UpdatePlans/_Plans/CoherenceCompute_Round9_Review_20261112
/UpdatePlans/_Plans/CoherenceRepair_Branch_Review_20261113
/UpdatePlans/_Plans/Research_Branch_Archive_89a5a84_before_main_f311845
!/UpdatePlans/_Plans/README.md
UpdatePlans/**/.render/
UpdatePlans/**/*.preview.html
UpdatePlans/**/__pycache__/

