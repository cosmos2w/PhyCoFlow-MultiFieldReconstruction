# Local scientific payloads. Keep catalog documentation and small source
# fixtures trackable; ignore only payload locations and their caches.
datasets/**/*.h5
datasets/**/*.hdf5
datasets/**/*.pt
datasets/**/*.pth
datasets/**/*.npy
datasets/**/*.npz
datasets/**/cache/
datasets/**/generated/
datasets/**/manifests/

# Local case runs, generated manifests, comparisons, and experiment profiles.
cases/**/runs/
cases/**/manifests/
cases/**/comparisons/*.json
cases/**/comparisons/*.csv
cases/**/comparisons/*.html
cases/**/comparisons/*.png
cases/**/comparisons/*.md
cases/**/configs/_experiments/

# Root-level run/checkpoint directories are local when used by ad-hoc tools.
runs/
checkpoints/

# Benchmark reports and derived output. Protocols, configs, scripts, and
# deliberately retained tiny fixtures remain source files.
benchmarks/**/reports/
benchmarks/**/generated/
benchmarks/**/report/*.json
benchmarks/**/report/*.csv
benchmarks/**/report/*.html
benchmarks/**/report/*.png
benchmarks/**/report/*.svg
benchmarks/**/report/*.pdf
benchmarks/**/execution/*.json
benchmarks/**/comparison/*.json
benchmarks/**/comparison/*.csv
benchmarks/**/comparison/*.html
benchmarks/**/baseline/*.json
benchmarks/**/baseline/*.csv
benchmarks/**/runs_summary/

# Exported figures and report directories are generated artifacts, not source.
figures/
reports/
artifacts/

# Python, test, editor, and build caches.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/
.venv/
venv/
.env
.DS_Store

# Local benchmark/experiment notes may be kept outside the tracked tree.
local-experiments/

# Optional historical source retained only for local compatibility checks.
LegacyCoherence/

# Slurm batch job logs written next to the submission directory.
slurm-*.out

# Personal Claude Code project instructions; not a shared repository contract.
CLAUDE.local.md

# Untracked historical topology snapshot, kept for reference development only.
src/phycoflow_reconstruction/coherence/families/topology/oldterm/

# Optional detached Betti-curve coherence package, kept local for continued
# development only. It registers as `topology_betti` when present and nothing
# else in the tree refers to it, so it may be absent without any other change.
src/phycoflow_reconstruction/coherence/families/topology_betti/

# Personal Slurm launch scripts. They carry per-machine partitions, accounts,
# module lines and GPU indices, so each coworker keeps their own locally.
# `scripts/slurm/train_tc_gl_rbf_cq_preemptable.sh` predates this rule and is still
# tracked; ignoring it here has no effect until it is untracked with `git rm --cached`.
scripts/slurm/*.sh
